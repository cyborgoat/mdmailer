{
  "name": "@goatcheese/mdmailer-core",
  "version": "0.1.1",
  "description": "Environment-neutral core of mdmailer: turn Markdown plus configuration into branded email HTML and EML. Runs in Node and in browsers.",
  "type": "module",
  "license": "MIT",
  "author": "cyborgoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyborgoat/mdmailer.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.build.json",
    "check:browser": "node scripts/check-browser.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "js-yaml": "^4.1.0",
    "markdown-to-jsx": "^9.10.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "esbuild": "^0.27.7",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.0.0",
    "puppeteer": "^25.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
