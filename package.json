{
  "name": "@cyborgoat/mdmailer",
  "version": "0.1.3",
  "description": "Turn a Markdown file into a branded HTML/EML email, ready to send manually. Configure your organization's name, logo, theme, and tagline once; write updates in plain Markdown.",
  "type": "module",
  "license": "MIT",
  "author": "cyborgoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyborgoat/mdmailer.git"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mdmailer": "dist/cli.js"
  },
  "scripts": {
    "generate": "tsx src/cli.ts generate",
    "init": "tsx src/cli.ts init",
    "email:dev": "email dev --dir src/emails/templates",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "gray-matter": "^4.0.3",
    "markdown-to-jsx": "^9.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/cli.js",
    "templates/news.md",
    "templates/notification.md",
    "templates/meeting.md",
    "templates/event.md",
    "templates/webinar.md",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "assets/images/hosts/priya-nair.jpg",
    "assets/images/hosts/marcus-cole.jpg"
  ],
  "publishConfig": {
    "access": "public"
  }
}
