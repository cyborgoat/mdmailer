{
  "name": "@cyborgoat/mdmailer",
  "version": "0.1.1",
  "description": "Turn a Markdown file into a branded HTML/EML email, ready to send manually. Configure your organization's name, logo, theme, and slogan once; write updates in plain Markdown.",
  "type": "module",
  "license": "MIT",
  "author": "cyborgoat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyborgoat/mailman.git"
  },
  "keywords": [
    "email",
    "markdown",
    "cli",
    "react-email",
    "branding"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mdmailer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "tsx src/cli.ts generate",
    "email:dev": "email dev --dir src/emails/templates",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "gray-matter": "^4.0.3",
    "markdown-to-jsx": "^9.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.3",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
